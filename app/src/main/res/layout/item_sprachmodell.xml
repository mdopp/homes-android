<?xml version="1.0" encoding="utf-8"?>
<!-- The box's language model as a card on the start screen (owner, 2026-11-17), in the
     favourites' look: a picture on a round, the title over the model and for whom, then the
     warning what the window costs, or the detail. Below, quiet, Homes' hint; a row per preset
     with a button per duration, and „Zurück zum Haushalt“. Every word is Homes'
     (sprachmodell/SprachmodellKarte fills it). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tile_homes"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/sm_bild"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/dot_homes"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_modul_sprechen" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sm_titel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/homes_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sm_zeile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/homes_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sm_unter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/homes_text_muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/sm_hinweis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/homes_text_faint"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sm_wahl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>

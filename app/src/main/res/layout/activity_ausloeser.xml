<?xml version="1.0" encoding="utf-8"?>
<!-- Mehr → Auslöser (homes ADR 0004): HA's tags, „Neuen Tag beschreiben“, the
     switch „Ladestation melden“. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ausloeser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/Text.Homes.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/ausloeser_title" />

        <TextView
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ausloeser_intro" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_homes"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/Text.Homes.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/ausloeser_tags_titel" />

            <LinearLayout
                android:id="@+id/ausloeser_liste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- The list's last row (owner 2026-11-27: „Neu nimmt zu viel Platz ein“): a tap opens the
                 form below in place; a blank tag held to the phone opens it too. -->
            <TextView
                android:id="@+id/ausloeser_neu_zeile"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/ausloeser_neu_zeile"
                android:textColor="@color/homes_accent" />

            <!-- A WLAN tag (owner 2026-11-27: „Ja WLAN schreiben“): its own form, closed until asked for. -->
            <TextView
                android:id="@+id/ausloeser_wlan_zeile"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/wlan_zeile"
                android:textColor="@color/homes_accent" />

            <!-- The network's name, its password (masked, „Passwort zeigen“; never saved with the screen's
                 state), open or not, the two plain warnings, the button that answers at once, „Abbrechen“. -->
            <LinearLayout
                android:id="@+id/wlan_formular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Homes.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/wlan_titel" />

                <TextView
                    style="@style/Text.Homes.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wlan_warnung" />

                <TextView
                    style="@style/Text.Homes.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/wlan_iphone" />

                <EditText
                    android:id="@+id/wlan_ssid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:hint="@string/wlan_ssid"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="32"
                    tools:targetApi="o" />

                <EditText
                    android:id="@+id/wlan_passwort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:hint="@string/wlan_passwort"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLength="64"
                    android:saveEnabled="false"
                    tools:targetApi="o" />

                <CheckBox
                    android:id="@+id/wlan_zeigen"
                    style="@style/Text.Homes.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wlan_zeigen" />

                <RadioGroup
                    android:id="@+id/wlan_schutz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/wlan_wpa2"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/wlan_wpa2"
                        style="@style/Text.Homes.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlan_wpa2" />

                    <RadioButton
                        android:id="@+id/wlan_offen"
                        style="@style/Text.Homes.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlan_offen" />
                </RadioGroup>

                <Button
                    android:id="@+id/wlan_schreiben"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/ausloeser_schreiben" />

                <!-- „WLAN anbieten“: the phone answers as the tag itself, for two minutes. -->
                <Button
                    android:id="@+id/wlan_anbieten"
                    style="@style/Widget.Homes.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/wlan_anbieten" />

                <Button
                    android:id="@+id/wlan_abbrechen"
                    style="@style/Widget.Homes.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/ausloeser_abbrechen" />

                <TextView
                    android:id="@+id/wlan_stand"
                    style="@style/Text.Homes.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm" />
            </LinearLayout>

            <!-- A new tag, or one named or renamed (§2), closed until asked for: its name with the
                 house's suggestions, „Was soll der Tag tun?“, the button that answers at once,
                 „Entfernen“ while one is changed, „Abbrechen“ that closes it. -->
            <LinearLayout
                android:id="@+id/ausloeser_formular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ausloeser_name_titel"
                    style="@style/Text.Homes.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/ausloeser_neu_titel" />

                <EditText
                    android:id="@+id/ausloeser_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ausloeser_name_hinweis"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="60"
                    tools:targetApi="o" />

                <!-- The house's rooms from HA and a few places, one tap each. -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/ausloeser_vorschlaege"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- „Was soll der Tag tun?“ (homes ADR 0004 §4): one choice per action the box lists. -->
                <TextView
                    android:id="@+id/ausloeser_aktion_frage"
                    style="@style/Text.Homes.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/ausloeser_aktion_frage"
                    android:visibility="gone" />

                <RadioGroup
                    android:id="@+id/ausloeser_aktion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/ausloeser_schreiben"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/ausloeser_schreiben" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/ausloeser_entfernen"
                        style="@style/Widget.Homes.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ausloeser_entfernen" />

                    <Button
                        android:id="@+id/ausloeser_zurueck"
                        style="@style/Widget.Homes.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/ausloeser_abbrechen" />
                </LinearLayout>
            </LinearLayout>

            <!-- How it stands; with NFC off a tap opens Android's NFC settings. -->
            <TextView
                android:id="@+id/ausloeser_stand"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="gone" />
        </LinearLayout>

        <!-- What is on a written tag held to the phone (owner 2026-11-27), before anything is offered,
             right under the tags (they stay the first card):
             a Homes tag's name, action and automations, a WLAN (its password behind „zeigen“), or
             anything else in plain words; up to two buttons, „Schließen“, and the card's own line. -->
        <LinearLayout
            android:id="@+id/ausloeser_inhalt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_homes"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                android:id="@+id/inhalt_titel"
                style="@style/Text.Homes.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs" />

            <TextView
                android:id="@+id/inhalt_text"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/inhalt_passwort_zeile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/inhalt_passwort"
                    style="@style/Text.Homes.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textIsSelectable="false" />

                <Button
                    android:id="@+id/inhalt_zeigen"
                    style="@style/Widget.Homes.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- A card with data of its own (owner 2026-11-28: „zeige mir die Daten“): what reads without
                 keys, hex and ASCII in monospace, wide lines scrolled sideways; on the screen only. -->
            <HorizontalScrollView
                android:id="@+id/inhalt_daten_rahmen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:visibility="gone">

                <TextView
                    android:id="@+id/inhalt_daten"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/homes_text"
                    android:textSize="12sp" />
            </HorizontalScrollView>

            <Button
                android:id="@+id/inhalt_eins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />

            <Button
                android:id="@+id/inhalt_zwei"
                style="@style/Widget.Homes.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <Button
                android:id="@+id/inhalt_drei"
                style="@style/Widget.Homes.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <Button
                android:id="@+id/inhalt_zu"
                style="@style/Widget.Homes.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/inhalt_zu" />

            <TextView
                android:id="@+id/inhalt_stand"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The tag being changed and its automations (homes ADR 0004 §8): each with „Lösen“, one to
             link to by name, a new one by a sentence; every change shown as a sentence first. -->
        <LinearLayout
            android:id="@+id/ausloeser_automationen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_homes"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                style="@style/Text.Homes.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/ausloeser_auto_titel" />

            <LinearLayout
                android:id="@+id/ausloeser_auto_liste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/ausloeser_auto_verbinden"
                style="@style/Widget.Homes.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/ausloeser_auto_verbinden" />

            <EditText
                android:id="@+id/ausloeser_auto_suche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="@string/ausloeser_auto_suche"
                android:importantForAutofill="no"
                android:inputType="text"
                android:visibility="gone"
                tools:targetApi="o" />

            <LinearLayout
                android:id="@+id/ausloeser_auto_treffer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <Button
                android:id="@+id/ausloeser_auto_neu"
                style="@style/Widget.Homes.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/ausloeser_auto_neu" />

            <EditText
                android:id="@+id/ausloeser_auto_satz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="@string/ausloeser_auto_satz"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:visibility="gone"
                tools:targetApi="o" />

            <Button
                android:id="@+id/ausloeser_auto_weiter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/ausloeser_auto_weiter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ausloeser_auto_stand"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_homes"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Homes.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ausloeser_laden_titel" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/ausloeser_laden"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/ausloeser_laden_titel" />
            </LinearLayout>

            <TextView
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ausloeser_laden_was" />

            <TextView
                android:id="@+id/ausloeser_laden_stand"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

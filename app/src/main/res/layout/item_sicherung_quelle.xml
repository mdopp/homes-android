<?xml version="1.0" encoding="utf-8"?>
<!-- One source on „Daten sichern“ (#194; owner 2026-11-08: state and one action): its
     line (✓ and the last transfer, or ⚠ and why), „Ordner freigeben“ while it is not set
     up, and only then its short guide, folded, with the way to the key in the archive. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_md"
    android:background="@drawable/card_homes"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <TextView
        android:id="@+id/quelle_name"
        style="@style/Text.Homes.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs" />

    <TextView
        android:id="@+id/quelle_zuletzt"
        style="@style/Text.Homes.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/quelle_waehlen"
        style="@style/Widget.Homes.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/sicherung_ordner_waehlen" />

    <!-- The guide, only while the source is not set up: folded, a tap unfolds it. -->
    <TextView
        android:id="@+id/quelle_wie"
        style="@style/Text.Homes.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs"
        android:text="@string/sicherung_wie"
        android:textColor="@color/homes_accent" />

    <LinearLayout
        android:id="@+id/quelle_anleitung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/quelle_schritte"
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/quelle_schluessel"
            style="@style/Widget.Homes.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/sicherung_schluessel" />
    </LinearLayout>

    <!-- What the box lacks here (homes ADR 0001 §10): the source's trace, its button disabled. -->
    <LinearLayout
        android:id="@+id/quelle_spur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- A tile of „Alles auf einen Blick“ (owner 2026-11-27, ui/Ueberblick): the area's picture,
     its name, one line of where it stands; a small green dot while the person has never opened it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_homes"
    android:foreground="?android:attr/selectableItemBackground"
    android:minHeight="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_sm">

        <ImageView
            android:id="@+id/bereich_bild"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            app:tint="@color/homes_accent" />

        <TextView
            android:id="@+id/bereich_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/homes_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bereich_stand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:textColor="@color/homes_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/bereich_neu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:contentDescription="@string/bereich_neu"
        android:text="@string/bereich_punkt"
        android:textColor="@color/terminal_green"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>

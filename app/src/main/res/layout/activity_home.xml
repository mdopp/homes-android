<?xml version="1.0" encoding="utf-8"?>
<!-- The app's one screen (#176): pair with Homes, then add widgets. targetSdk 35
     draws edge-to-edge, so HomeActivity adds the system-bar insets onto the
     root's padding; the root carries an id for that. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_ground"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <!-- The app's icon, the assistant's name (/napi/assistent), a rule in the fixed accent. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_lg"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/assistent_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="@dimen/space_sm"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/assistent_name"
                style="@style/Text.Homes.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistent_name" />

            <View
                android:layout_width="52dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@color/terminal_green" />

            <TextView
                android:id="@+id/home_claim"
                style="@style/Text.Homes.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_horizontal"
                android:text="@string/home_claim" />
        </LinearLayout>

        <!-- Unpaired: Homes' address, then /pair-device. -->
        <LinearLayout
            android:id="@+id/connect_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_homes"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/connect_hint"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/home_connect_hint" />

            <EditText
                android:id="@+id/server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/home_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true" />

            <Button
                android:id="@+id/connect_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/home_connect" />

            <Button
                android:id="@+id/qr_scan_btn"
                style="@style/Widget.Homes.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/qr_scan" />
        </LinearLayout>

        <!-- Paired: the person's favorite devices first (owner, 2026-11-02), then
             where to, and the widgets to add. -->
        <LinearLayout
            android:id="@+id/connected_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Hochladen (owner, 2026-11-04): what its notification says, in one quiet row —
                 a file going up, a pause, or what came of the files (hochladen/Stand.kt). -->
            <TextView
                android:id="@+id/hochladen_zeile"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/card_homes"
                android:padding="@dimen/card_padding"
                android:textColor="@color/homes_text"
                android:visibility="gone" />

            <!-- While the values are not current (Verbindung): the box not reachable,
                 no network, the pairing refused (a tap then pairs again). -->
            <TextView
                android:id="@+id/verbindung"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/card_homes"
                android:padding="@dimen/card_padding"
                android:textColor="@color/homes_text"
                android:visibility="gone" />

            <!-- The section's head: the title and „Alle →“, Homes' devices page (owner, 2026-11-04).
                 The link keeps its 48 dp; the hint below moves up into the head's spare room. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Text.Homes.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_devices_title" />

                <TextView
                    android:id="@+id/devices_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:layout_marginEnd="-8dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="@string/home_devices_all_link"
                    android:contentDescription="@string/home_devices_all"
                    android:textColor="@color/homes_accent"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/Text.Homes.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/home_devices_hint" />

            <!-- The favorites from Homes (/napi/portal/favorites) as tiles (FavoritenAnsicht). -->
            <LinearLayout
                android:id="@+id/devices_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:orientation="vertical" />

            <!-- Öffnen (owner, 2026-11-04): the modules without a phone app of their own,
                 each in a Custom Tab; gone without /napi/einrichtung (einrichtung/Abschnitte). -->
            <LinearLayout
                android:id="@+id/oeffnen_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Homes.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/oeffnen_titel" />

                <TextView
                    style="@style/Text.Homes.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/oeffnen_hinweis" />

                <LinearLayout
                    android:id="@+id/oeffnen_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_homes"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Deine Aufgaben: the open setup tasks, the number open beside the title as
                 on Homes' pages; gone while none is open. -->
            <LinearLayout
                android:id="@+id/aufgaben_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Homes.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/aufgaben_titel" />

                    <TextView
                        android:id="@+id/aufgaben_zahl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:background="@drawable/zahl_homes"
                        android:gravity="center"
                        android:minWidth="24dp"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:textColor="@color/homes_bg"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aufgaben_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_homes"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                style="@style/Text.Homes.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_widgets_title" />

            <TextView
                style="@style/Text.Homes.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/home_widgets_hint" />

            <!-- One card (owner, 2026-11-03): the widgets to add, then, in the same
                 row style and only while the battery exemption is missing, the row
                 that asks for „Zulassen“ (owner 2026-11-08: no live switch, live
                 is the one way). -->
            <LinearLayout
                android:id="@+id/widgets_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_homes"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widgets_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Widgets aktuell halten: gone once the exemption is granted (HomeActivity.render). -->
                <LinearLayout
                    android:id="@+id/live_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/homes_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/live_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/live_battery_title"
                            android:textColor="@color/homes_text"
                            android:textSize="16sp" />

                        <!-- The one action: „Zulassen“, so a restart after a killed process goes live by itself. -->
                        <TextView
                            android:id="@+id/live_battery"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/live_battery_off"
                            android:textColor="@color/homes_text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Mehr (#194): what the app does beyond the widgets. -->
            <TextView
                style="@style/Text.Homes.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/home_mehr" />

            <LinearLayout
                android:id="@+id/mehr_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_homes"
                android:orientation="vertical" />

            <!-- What the box lacks (homes ADR 0001 §10): quiet, one trace per module,
                 each with „Hier anfordern“; gone while the box lacks nothing or
                 what it can do is unknown. -->
            <LinearLayout
                android:id="@+id/spuren_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Homes.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:textColor="@color/homes_text_muted"
                    android:text="@string/spuren_titel" />

                <TextView
                    style="@style/Text.Homes.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/spuren_hinweis" />

                <LinearLayout
                    android:id="@+id/spuren_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_homes"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Where the app is paired, beside the way to unpair (owner, 2026-11-03). -->
            <TextView
                android:id="@+id/status"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_sm"
                android:gravity="center_horizontal" />

            <Button
                android:id="@+id/logout_btn"
                style="@style/Widget.Homes.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_logout" />
        </LinearLayout>

        <TextView
            android:id="@+id/app_version"
            style="@style/Text.Homes.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="@string/app_version_placeholder" />
    </LinearLayout>
</ScrollView>

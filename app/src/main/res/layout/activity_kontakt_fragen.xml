<?xml version="1.0" encoding="utf-8"?>
<!-- Daten erfragen (owner 2026-11-28: „direkt als Screen … Ein Klick weniger“): ← top-left, the
     contact's initials and name, the card with the state line (and its progress while it runs), and
     the ways on the screen itself — one tap sends. KontaktFragenActivity fills it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_xl">

        <ImageButton
            android:id="@+id/fragen_zu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fragen_schliessen"
            android:src="@drawable/ic_zurueck" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fragen_initialen"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="@dimen/space_md"
                android:background="@drawable/kreis_initialen"
                android:gravity="center"
                android:textColor="@color/homes_accent"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/fragen_name"
                style="@style/Text.Homes.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fragen_titel" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/card_homes"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/fragen_laeuft"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/homes_accent" />

                <TextView
                    android:id="@+id/fragen_stand"
                    style="@style/Text.Homes.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/fragen_neu"
                style="@style/Text.Homes.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/fragen_neu"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fragen_knoepfe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

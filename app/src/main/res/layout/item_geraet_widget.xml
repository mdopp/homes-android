<?xml version="1.0" encoding="utf-8"?>
<!-- „+ Gerät als Widget auf den Startbildschirm“ (owner 2026-11-28): a quiet row atop „Deine Geräte“, 48 dp to tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="@dimen/space_xs"
        android:contentDescription="@null"
        android:src="@drawable/ic_ctl_plus"
        app:tint="@color/homes_accent" />

    <TextView
        android:id="@+id/geraet_widget_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/homes_accent"
        android:textSize="@dimen/text_body" />
</LinearLayout>

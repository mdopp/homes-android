<?xml version="1.0" encoding="utf-8"?>
<!-- „WLAN anbieten“ (owner 2026-11-27): the network, what to do, how long still, „Beenden“. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/anbieten_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/Text.Homes.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/anbieten_titel" />

        <TextView
            android:id="@+id/anbieten_netz"
            style="@style/Text.Homes.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/anbieten_halte"
            style="@style/Text.Homes.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/anbieten_halte" />

        <TextView
            android:id="@+id/anbieten_stand"
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" />

        <Button
            android:id="@+id/anbieten_beenden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/anbieten_beenden" />
    </LinearLayout>
</ScrollView>

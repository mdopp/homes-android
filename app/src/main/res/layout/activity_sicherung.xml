<?xml version="1.0" encoding="utf-8"?>
<!-- Mehr → Daten sichern (#194; owner 2026-11-08: only what needs the phone): the link to
     Homes' overview, the two folders, the switches for contacts and for SMS and calls
     (laib ADR 0029), „Jetzt sichern“. Edge-to-edge like the home screen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sicherung_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homes_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/Text.Homes.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/sicherung_title" />

        <!-- Everything at a glance, keys and E-Mail included, is Homes' page (owner 2026-11-08). -->
        <TextView
            android:id="@+id/sicherung_ueberblick"
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs"
            android:text="@string/sicherung_ueberblick"
            android:textColor="@color/homes_accent" />

        <!-- Homes' own sentence why it cannot take backups, or that the app is not paired. -->
        <TextView
            android:id="@+id/sicherung_hinweis"
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone" />

        <include
            android:id="@+id/sicherung_whatsapp"
            layout="@layout/item_sicherung_quelle" />

        <include
            android:id="@+id/sicherung_signal"
            layout="@layout/item_sicherung_quelle" />

        <!-- Kontakte (laib ADR 0029): the switch in its title row, off until the person turns it on. -->
        <LinearLayout
            android:id="@+id/handy_kontakte_karte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_homes"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Homes.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/handy_kontakte_titel" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/handy_kontakte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/handy_kontakte" />
            </LinearLayout>

            <TextView
                android:id="@+id/handy_kontakte_stand"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Why it is off or what went wrong; a tap opens App-Info when the way is through there. -->
            <TextView
                android:id="@+id/handy_kontakte_meldung"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="@color/homes_accent"
                android:visibility="gone" />
            <!-- What the box lacks here (homes ADR 0001 §10): the part's trace, below its disabled switch. -->
            <LinearLayout
                android:id="@+id/handy_kontakte_spur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <!-- SMS und Anrufe (laib ADR 0029): the switch in its title row, off until the person turns it on. -->
        <LinearLayout
            android:id="@+id/handy_sms_karte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_homes"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Homes.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/handy_sms_titel" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/handy_sms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/handy_sms" />
            </LinearLayout>

            <TextView
                android:id="@+id/handy_sms_stand"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Why it is off or what went wrong; a tap opens App-Info when the way is through there. -->
            <TextView
                android:id="@+id/handy_sms_meldung"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="@color/homes_accent"
                android:visibility="gone" />
            <!-- What the box lacks here (homes ADR 0001 §10): the part's trace, below its disabled switch. -->
            <LinearLayout
                android:id="@+id/handy_sms_spur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/sicherung_jetzt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/sicherung_jetzt" />

        <ProgressBar
            android:id="@+id/sicherung_balken"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:max="1000"
            android:progressTint="@color/homes_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sicherung_zustand"
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/sicherung_ruht" />

        <!-- a new phone: the newest backup back from the box (homes-android#197) -->
        <Button
            android:id="@+id/sicherung_zurueck"
            style="@style/Widget.Homes.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/zurueck_oeffnen" />
    </LinearLayout>
</ScrollView>

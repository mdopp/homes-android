<?xml version="1.0" encoding="utf-8"?>
<!-- „Kontakt austauschen“ → „Was teilen?“ (owner 2026-11-28): where it stands, the link again, the card's fields,
     the guest Wi-Fi, the form; Freigeben, Beenden. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/austausch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/Text.Homes.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xs"
            android:text="@string/austausch_frage" />

        <TextView
            android:id="@+id/austausch_stand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/homes_accent"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal">

            <Button
                android:id="@+id/austausch_nfc"
                style="@style/Widget.Homes.Button.Control"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/austausch_nfc_nochmal" />

            <Button
                android:id="@+id/austausch_qr"
                style="@style/Widget.Homes.Button.Control"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/austausch_qr_nochmal" />
        </LinearLayout>

        <TextView
            style="@style/Text.Homes.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/austausch_karte" />

        <TextView
            android:id="@+id/austausch_vorname"
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/austausch_felder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/austausch_karte_festlegen"
            style="@style/Widget.Homes.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/austausch_karte_festlegen"
            android:visibility="gone" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/austausch_wlan"
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/austausch_eintragen"
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/austausch_eintragen" />

        <Button
            android:id="@+id/austausch_freigeben"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/austausch_freigeben" />

        <TextView
            android:id="@+id/austausch_meldung"
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" />

        <Button
            android:id="@+id/austausch_beenden"
            style="@style/Widget.Homes.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/austausch_beenden" />
    </LinearLayout>
</ScrollView>
